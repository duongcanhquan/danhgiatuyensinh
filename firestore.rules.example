rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Bảng kê collection id (đồng bộ `FS_COLLECTIONS` trong src/types.ts) ---
    // users, leads, leadSources, scholarships, scoringProfiles, scoringRuleTemplates, scoringAux,
    // orgSettings/{orgId}/settings/{docId}, organizations, platformAuditLogs,
    // masterData, consultingPlaybooks, scriptSnippets, auditLogs, knowledgeDocuments, ai_tasks, financeReports,
    // omicallCalls, omicallSyncRuns, kpiDaily,
    // leads/{id}/interactions, leads/{id}/aiInsightTasks
    //
    // --- Phase 0–4 multi-tenant (school = orgId) ---
    // Production rules live in `firestore.rules` (firebase.json).
    // Dev open rules: `firestore.rules.dev.example`.
    //
    // Auth custom claims (synced by functions/syncAuthClaimsOnUserWrite):
    //   school: { role, orgId, platform: false }
    //   platform super_admin: { role: 'super_admin', orgId: '', platform: true }
    //
    // Deploy order:
    //   1) firebase deploy --only functions:syncAuthClaimsOnUserWrite,functions:refreshOwnAuthClaims
    //   2) APPLY=1 npm run migrate:sync-auth-claims
    //   3) npm run deploy:firestore-rules
    //
    // This file is a pointer stub — copy production or open the real files above.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
