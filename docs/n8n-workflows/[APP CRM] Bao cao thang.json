      "parameters": {
        "jsCode": "const raw = $input.item.json;\nconst body = raw.body && typeof raw.body === 'object' ? raw.body : raw;\nlet text = String(body.message_vi || body.chat_text || '').trim();\nif (!text) {\n  const month = body.month || '';\n  text = [\n    `📆 BÁO CÁO THÁNG ${month}`,\n    `NB (chưa thu): ${body.nbMonth ?? 0}`,\n    `LPXT: ${body.lpxtMonth ?? 0}`,\n    `NE / hoàn thiện: ${body.neMonth ?? 0}`,\n    `Top TVV: ${body.topTvvName || '—'} (${body.topTvvCount ?? 0})`,\n  ].join('\\n');\n}\ntext = '🆕 [APP CRM]\\n' + text;\nreturn [{ json: { google_chat_payload: { text }, message_vi: text } }];"
      },
      "id": "code-normalize-monthly",
      "name": "Chuẩn hóa báo cáo tháng",
