rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // PRODUCTION multi-tenant Rules (school = orgId)
    // Deploy ONLY after Auth custom claims are synced:
    //   1) deploy functions (syncAuthClaimsOnUserWrite)
    //   2) APPLY=1 npm run migrate:sync-auth-claims
    //   3) npm run deploy:firestore-rules
    // Dev catch-all: firestore.rules.dev.example
    // =====================================================================

    function signedIn() {
      return request.auth != null;
    }

    /** Hồ sơ users của người đang đăng nhập — fallback khi custom claims chưa kịp. */
    function callerUserPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function callerHasUserDoc() {
      return signedIn() && exists(callerUserPath());
    }

    function callerUser() {
      return get(callerUserPath()).data;
    }

    // Super_admin = nền tảng. Token claims HOẶC role trên users/{uid}.
    function isPlatform() {
      return signedIn() && (
        request.auth.token.role == 'super_admin'
        || request.auth.token.platform == true
        || (callerHasUserDoc() && callerUser().role == 'super_admin')
      );
    }

    function tokenOrg() {
      return request.auth.token.orgId;
    }

    function hasTokenOrg() {
      return tokenOrg() is string && tokenOrg().size() > 0;
    }

    /** orgId hiệu lực: claims → users/{uid}.orgId (tránh Tổng kết permission-denied khi token cũ). */
    function resolvedOrgId() {
      return hasTokenOrg()
        ? tokenOrg()
        : (
          callerHasUserDoc()
            && 'orgId' in callerUser()
            && callerUser().orgId is string
            && callerUser().orgId.size() > 0
              ? callerUser().orgId
              : ''
        );
    }

    function hasResolvedOrg() {
      return resolvedOrgId().size() > 0;
    }

    function orgIsSuspended(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'suspended';
    }

    function schoolOrgActive() {
      return isPlatform()
        || (hasResolvedOrg() && !orgIsSuspended(resolvedOrgId()));
    }

    function dataHasOrg(data) {
      return data.keys().hasAll(['orgId'])
        && data.orgId is string
        && data.orgId.size() > 0;
    }

    /** Platform OR same org OR (legacy doc without orgId while school is vietmy). */
    function matchesOrgData(data) {
      return isPlatform()
        || (hasResolvedOrg() && dataHasOrg(data) && data.orgId == resolvedOrgId())
        || (hasResolvedOrg() && resolvedOrgId() == 'vietmy' && !dataHasOrg(data));
    }

    function createInOwnOrg() {
      return isPlatform()
        || (hasResolvedOrg()
          && schoolOrgActive()
          && dataHasOrg(request.resource.data)
          && request.resource.data.orgId == resolvedOrgId());
    }

    function createLegacyVietmyOk() {
      return hasResolvedOrg()
        && resolvedOrgId() == 'vietmy'
        && schoolOrgActive()
        && !dataHasOrg(request.resource.data);
    }

    function updateKeepsOrg() {
      return isPlatform()
        || (hasResolvedOrg()
          && schoolOrgActive()
          && matchesOrgData(resource.data)
          && (
            (dataHasOrg(request.resource.data) && request.resource.data.orgId == resolvedOrgId())
            || (!dataHasOrg(request.resource.data) && resolvedOrgId() == 'vietmy')
          ));
    }

    function deleteInOwnOrg() {
      return isPlatform()
        || (hasResolvedOrg() && schoolOrgActive() && matchesOrgData(resource.data));
    }

    /** Chỉ Admin trường / Siêu quản trị được xóa hồ sơ. */
    function canDeleteLead() {
      return isPlatform()
        || (signedIn()
          && (
            request.auth.token.role == 'admin'
            || (callerHasUserDoc() && callerUser().role == 'admin')
          )
          && hasResolvedOrg()
          && schoolOrgActive()
          && matchesOrgData(resource.data));
    }

    function orgScopedRead() {
      return signedIn() && schoolOrgActive() && matchesOrgData(resource.data);
    }

    function orgScopedCreate() {
      return signedIn() && (createInOwnOrg() || createLegacyVietmyOk());
    }

    function orgScopedWrite() {
      return signedIn() && (updateKeepsOrg());
    }

    // ----- Platform registry -----
    match /organizations/{orgId} {
      allow read: if signedIn();
      allow create, update, delete: if isPlatform();
    }

    match /platformAuditLogs/{id} {
      allow read: if isPlatform();
      allow create: if isPlatform();
      allow update, delete: if false;
    }

    match /orgSettings/{orgId} {
      allow read: if isPlatform() || (hasResolvedOrg() && resolvedOrgId() == orgId && schoolOrgActive());
      allow write: if isPlatform() || (hasResolvedOrg() && resolvedOrgId() == orgId && schoolOrgActive());

      match /settings/{docId} {
        allow read: if isPlatform() || (hasResolvedOrg() && resolvedOrgId() == orgId && schoolOrgActive());
        allow write: if isPlatform() || (hasResolvedOrg() && resolvedOrgId() == orgId && schoolOrgActive());
      }
    }

    // ----- Users -----
    match /users/{uid} {
      // Giống leads: VietMy legacy thiếu orgId vẫn đọc được khi token.orgId == vietmy.
      allow read: if isPlatform()
        || (signedIn() && request.auth.uid == uid)
        || (hasTokenOrg() && schoolOrgActive() && matchesOrgData(resource.data));

      allow create: if isPlatform()
        || (hasTokenOrg()
          && schoolOrgActive()
          && request.resource.data.orgId == tokenOrg());

      allow update: if isPlatform()
        || (signedIn()
          && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'orgId', 'isActive', 'extraPermissions', 'deniedPermissions']))
        || (hasTokenOrg()
          && schoolOrgActive()
          && matchesOrgData(resource.data)
          && (
            (dataHasOrg(request.resource.data) && request.resource.data.orgId == tokenOrg())
            || (!dataHasOrg(request.resource.data) && tokenOrg() == 'vietmy')
          ));

      allow delete: if isPlatform();
    }

    // ----- Leads + subcollections -----
    match /leads/{leadId} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if canDeleteLead();

      match /interactions/{id} {
        allow read, write: if signedIn() && (
          isPlatform()
          || (schoolOrgActive()
            && matchesOrgData(get(/databases/$(database)/documents/leads/$(leadId)).data))
        );
      }

      match /aiInsightTasks/{id} {
        allow read, write: if signedIn() && (
          isPlatform()
          || (schoolOrgActive()
            && matchesOrgData(get(/databases/$(database)/documents/leads/$(leadId)).data))
        );
      }
    }

    // ----- Legacy global scoringAux (vietmy only until fully migrated) -----
    match /scoringAux/{docId} {
      allow read, write: if isPlatform()
        || (resolvedOrgId() == 'vietmy' && schoolOrgActive());
    }

    // ----- Lead audit (no orgId on docs yet — school-active staff only) -----
    match /auditLogs/{id} {
      allow read: if signedIn() && schoolOrgActive();
      allow create: if signedIn() && schoolOrgActive();
      allow update, delete: if isPlatform();
    }

    // ----- Org-scoped business collections -----
    match /scoringProfiles/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /scoringRuleTemplates/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /scoringRuleSets/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /masterData/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /consultingPlaybooks/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /scriptSnippets/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /knowledgeDocuments/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /scholarships/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /leadSources/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /ai_tasks/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /financeReports/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    // Lịch sử gọi — Admin SDK ghi; client đọc khi trường đang active (giống kpiDaily).
    // Không bắt matchesOrgData trên list query (doc cũ thiếu orgId → permission-denied trên Tổng kết).
    match /omicallCalls/{id} {
      allow read: if signedIn() && schoolOrgActive();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }
    match /omicallSyncRuns/{id} {
      allow read: if orgScopedRead() || isPlatform();
      allow write: if isPlatform();
    }
    match /routingPolicies/{id} {
      allow read: if orgScopedRead();
      allow create: if orgScopedCreate();
      allow update: if orgScopedWrite();
      allow delete: if deleteInOwnOrg();
    }

    // KPI daily / stats — Admin SDK writes; clients read if signed in + org active
    match /kpiDaily/{dateId} {
      allow read: if signedIn() && schoolOrgActive();
      allow write: if false;
      match /{document=**} {
        allow read: if signedIn() && schoolOrgActive();
        allow write: if false;
      }
    }

    match /stats/{document=**} {
      allow read: if signedIn() && schoolOrgActive();
      allow write: if false;
    }

    // Deny everything else (no open catch-all)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
